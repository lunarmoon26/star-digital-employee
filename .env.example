# Slack Socket Mode connector (scripts/slack-echo.ts)
# App-level token from api.slack.com/apps → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-1-...
# Bot user OAuth token from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# Workspace identity label for the ledger
STAR_ACCOUNT=haochuanz
# Where the durable ledger lives
STAR_LEDGER_PATH=.star/slack-echo.sqlite

# Gmail connector (Application Default Credentials)
# One-time: grant Gmail scopes to ADC (opens a browser for consent):
#   gcloud auth application-default login \
#     --scopes="https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send"
# Mailbox to monitor and send from (defaults to the authenticated user)
GMAIL_USER_ID=you@haochuanz.net
